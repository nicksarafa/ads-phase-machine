# ---- Copy-writing model (phases: research / generate / evaluate / evolve) ----
# Preferred. Without it the app falls back to the `claude` CLI (your existing
# Claude Code auth), and then to a deterministic offline generator.
ANTHROPIC_API_KEY=

# Model used for ad copy + strategy. Default: claude-opus-5
ADS_LLM_MODEL=claude-opus-5

# Effort for copy generation: low | medium | high | xhigh | max. Default: low
# (low keeps the demo loop fast; raise it if you want richer strategy.)
ADS_LLM_EFFORT=low

# Hard ceiling on how long a phase waits for copy before falling back to the
# offline composer, so the loop can never stall in `generate`. Default 100000
ADS_LLM_TIMEOUT_MS=100000

# ---- Image generation (phase: render) ----
# Provider chain, first match wins. Options:
#   google     - Gemini image models ("Nano Banana Pro"), needs GEMINI_API_KEY
#   openai     - needs OPENAI_API_KEY, uses the images endpoint
#   claude-mcp - shells out to `claude -p` and uses a connected image MCP
#   procedural - deterministic generative artwork, instant, no network
# Default: auto (google -> openai -> claude-mcp -> procedural)
ADS_IMAGE_PROVIDER=auto

# Google "Nano Banana Pro". Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# How many AI images may render concurrently. Default: 2
ADS_IMAGE_CONCURRENCY=2
