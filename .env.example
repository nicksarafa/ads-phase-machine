# ---- Copy-writing model (phases: research / generate / evaluate / evolve) ----
# Preferred. Without it the app falls back to the `claude` CLI (your existing
# Claude Code auth), and then to a deterministic offline generator.
ANTHROPIC_API_KEY=

# Model used for ad copy + strategy. Default: claude-opus-5
ADS_LLM_MODEL=claude-opus-5

# Effort for copy generation: low | medium | high | xhigh | max. Default: low
# (low keeps the demo loop fast; raise it if you want richer strategy.)
ADS_LLM_EFFORT=low

# Hard ceiling on how long a phase waits for copy before falling back to the
# offline composer, so the loop can never stall in `generate`. Default 100000
ADS_LLM_TIMEOUT_MS=100000

# ---- Image generation (phase: render) ----
# Provider chain, first match wins. Options:
#   google     - Gemini image models ("Nano Banana Pro"), needs GEMINI_API_KEY
#   openai     - needs OPENAI_API_KEY, uses the images endpoint
#   claude-mcp - shells out to `claude -p` and uses a connected image MCP
#   procedural - deterministic generative artwork, instant, no network
# Default: auto (google -> openai -> claude-mcp -> procedural)
ADS_IMAGE_PROVIDER=auto

# Google "Nano Banana Pro". Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# How many AI images may render concurrently. Default: 2
ADS_IMAGE_CONCURRENCY=2

# ---- Live placement on Meta (phases: launch / observe) ----
# LEAVE ALL OF THIS EMPTY unless you intend to place real ads on a real ad
# account. With ADS_LIVE unset the machine simulates delivery and cannot spend
# a cent, whatever the dashboard toggle says.
#
# Placement goes through the `facebook-ads` MCP driven by your local `claude`
# CLI, so there is no Meta token to store here — it reuses the authorisation
# already in your Claude Code credential store. Connect it once with:
#   claude mcp add --transport http facebook-ads https://mcp.facebook.com/ads
#
# Ads are always created PAUSED. Nothing spends until you activate the campaign
# by hand in Meta Ads Manager.
ADS_LIVE=

# Hard ceiling, in dollars, that the process refuses to cross regardless of what
# the UI or the saved state asks for. Default: 10
ADS_LIVE_MAX_DAILY_USD=10

# Your Meta ad account id (digits only, no `act_` prefix) and the Facebook Page
# the ads post as. The Page must be promoted under that ad account.
ADS_META_AD_ACCOUNT_ID=
ADS_META_PAGE_ID=

# Where the ad's clicks go. Required — placement refuses without it.
ADS_LANDING_URL=

# Targeting, as a custom-location pin rather than a city key. Defaults are
# Lisbon city centre with a 40km radius.
ADS_GEO_CITY=Lisbon
ADS_GEO_COUNTRY=PT
ADS_GEO_LAT=38.7223
ADS_GEO_LNG=-9.1393
ADS_GEO_RADIUS_KM=40

# How long a single Meta step may take before it is killed. Default 300000
ADS_LIVE_TIMEOUT_MS=300000

# Minutes between reads of Meta in live mode. Every read is a billable model
# call and Meta's reporting only moves every few tens of minutes, so polling
# faster costs money and tells you nothing new. Default: 30
ADS_LIVE_POLL_MINUTES=30
